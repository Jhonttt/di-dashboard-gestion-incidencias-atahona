#!/bin/sh
. "$(dirname "$0")/lib/ui.sh"

TIME_FILE="$(git rev-parse --git-dir)/.hooks-elapsed"
OUT_FILE=$(mktemp)
rm -f "$TIME_FILE"

trap 'rm -f "$OUT_FILE"; printf "%s" "$SHOW_CURSOR" >&2' EXIT
trap 'exit 130' INT TERM

START=$(now_ms)
header "Comprobando el código antes del commit"

# run_check "Nombre" "Cómo arreglarlo" comando...
run_check() {
  NAME=$1
  FIX=$2
  shift 2

  T0=$(now_ms)
  "$@" > "$OUT_FILE" 2>&1 &
  PID=$!
  spin "$PID" "$NAME"

  if wait "$PID"; then
    ok_line "$NAME" "$(fmt_ms $(( $(now_ms) - T0 )))"
  else
    fail_line "$NAME" "$(fmt_ms $(( $(now_ms) - T0 )))"
    printf '\n' >&2
    sed 's/^/    /' "$OUT_FILE" >&2
    printf '\n  %sSolución:%s %s\n\n' "$YELLOW" "$RESET" "$FIX" >&2
    printf '%s✖ Commit cancelado%s\n\n' "$RED$BOLD" "$RESET" >&2
    exit 1
  fi
}

run_check "Formato (Spotless)"  "ejecuta mvn spotless:apply y vuelve a hacer git add" \
  mvn -q spotless:check

run_check "Estilo (Checkstyle)" "corrige los errores indicados arriba" \
  mvn -q checkstyle:check

# El bloque lo cierra commit-msg
echo $(( $(now_ms) - START )) > "$TIME_FILE"